<Window x:Class="PromptSelenium.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Selenium - ChatGPT Web Excel Automation"
        Width="1240" Height="850" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" Padding="24,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Prompt Selenium" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Excel → 5 ChatGPT web workers → Prompt 1 → Prompt 2 → Prompt 3 → Final Excel"
                               Foreground="#AAB4C7" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#243047" CornerRadius="16" Padding="14,7">
                    <TextBlock Text="{Binding ConnectionText}" Foreground="#7EE2C4" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1. EXCEL" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="Input có cột Story" Margin="0,10,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding InputPath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Command="{Binding BrowseInputCommand}" IsEnabled="{Binding IsNotBusy}" />
                            </Grid>
                            <TextBlock Text="Output final" Margin="0,10,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputPath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" IsEnabled="{Binding IsNotBusy}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="2. CHROME + CHATGPT" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="chrome.exe" Margin="0,10,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ChromePath}" />
                                <Button Grid.Column="1" Content="..." Margin="8,0,0,0" Command="{Binding BrowseChromeCommand}" IsEnabled="{Binding IsNotBusy}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Debug port" />
                                <TextBox Grid.Column="1" Text="{Binding DebugPort}" HorizontalContentAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số tab/worker" />
                                <TextBox Grid.Column="1" Text="{Binding WorkerCount}" HorizontalContentAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Timeout mỗi response (phút)" />
                                <TextBox Grid.Column="1" Text="{Binding ResponseTimeoutMinutes}" HorizontalContentAlignment="Center" />
                            </Grid>
                            <Button Content="Launch ChatGPT tabs" Command="{Binding LaunchChromeCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,12,0,0" />
                            <Button Content="Connect &amp; Verify tabs" Command="{Binding ConnectCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,8,0,0" />
                            <TextBlock Text="Đăng nhập thủ công. Không đóng các tab trong lúc chạy."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="3. RUN" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                            <Button Content="Start Processing" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,12,0,0" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Margin="0,8,0,0" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Progress" />
                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="{Binding TotalStories}" Value="{Binding CompletedStories}" Height="8" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <TabControl BorderThickness="0" Background="Transparent">
                        <TabItem Header="Prompt 1">
                            <TextBox Text="{Binding Prompt1, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" IsEnabled="{Binding IsNotBusy}" />
                        </TabItem>
                        <TabItem Header="Prompt 2">
                            <TextBox Text="{Binding Prompt2, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" IsEnabled="{Binding IsNotBusy}" />
                        </TabItem>
                        <TabItem Header="Prompt 3">
                            <TextBox Text="{Binding Prompt3, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" IsEnabled="{Binding IsNotBusy}" />
                        </TabItem>
                    </TabControl>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ACTIVITY LOG" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="#FAFBFC">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="3" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0" Padding="20,9">
            <TextBlock Text="Mỗi story dùng chat mới; chỉ Prompt 1 gắn story Excel. Prompt 2 và 3 gửi tiếp nguyên văn trong cùng chat."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </Border>
    </Grid>
</Window>
